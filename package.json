{
  "name": "reactreach",
  "version": "1.0.0",
  "description": "React dependency vulnerability reachability analyser",
  "keywords": [
    "react",
    "static-analysis",
    "software-composition-analysis",
    "vulnerability-reachability",
    "sarif"
  ],
  "homepage": "https://github.com/hellen-santos-07/ReactReach#readme",
  "bugs": {
    "url": "https://github.com/hellen-santos-07/ReactReach/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellen-santos-07/ReactReach.git"
  },
  "license": "MIT",
  "author": "Hellen Santos",
  "engines": {
    "node": ">=24"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./src/config": "./src/config.js",
    "./src/dependency/runAudit": "./src/dependency/runAudit.js",
    "./src/report/generateReport": "./src/report/generateReport.js",
    "./src/sinks/registry": "./src/sinks/registry.js"
  },
  "files": [
    "src",
    "schemas"
  ],
  "bin": {
    "reactreach": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "nodemon src/cli.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 test/*.test.js",
    "test:schema": "node scripts/validateSchemas.js",
    "metrics:complexity": "node scripts/measureComplexity.js"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "nodemon": "^3.1.14"
  }
}
